{
  "name": "urlchop",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:client": "pnpm --filter urlchop-client-app dev",
    "dev:server": "pnpm --filter urlchop-server-app dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter urlchop-server-app test",
    "lint": "pnpm --filter urlchop-client-app lint"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@tailwindcss/oxide"
    ]
  }
}
